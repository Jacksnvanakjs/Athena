# Bark（推荐，iOS，无需国内实名）
# 1. App Store 安装 Bark：https://apps.apple.com/app/bark-customed-notifications/id1403753865
# 2. 打开 App，复制页面上的 key（或整段 https://api.day.app/xxxxx）
# 3. Belmo / .env 填写：
BARK_DEVICE_KEY=your_bark_device_key_here
# BARK_SERVER_URL=https://api.day.app
# BARK_GROUP=Athena
# 测一下：.venv/bin/python scripts/send_bark_test.py

# PushPlus（需实名，可不配）
# PUSHPLUS_TOKEN=

# 本地 SQLite（未配置 Turso 时使用）
DATABASE_URL=sqlite:///./data/funds.db

# Turso 云端数据库（推荐：本地与 Belmo 均用同一 Turso，历史数据不丢）
# 在 https://turso.tech 用 GitHub 注册，创建数据库后填写以下两项
# TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here
# 启动探测超时（秒）：超时先起 HTTP，后台只重试 Turso（绝不切本地 SQLite）
# TURSO_CONNECT_TIMEOUT_SEC=45
# TURSO_RECONNECT_INTERVAL_SEC=15
# TURSO_CONNECT_RETRIES=2
# 多区域 URL（逗号分隔）。注意：Turso 已弃用 Edge Replicas，AWS 上
# `turso db replicate` / group locations add 目前不可用；sin/hkg 也不在可选区。
# 就近方案：新建 group（如 --location aws-ap-south-1 孟买）后 import 迁移，
# 把 TURSO_DATABASE_URL 切到新主库；不要把另一份独立库填进 FALLBACKS（会双写分裂）。
# TURSO_DATABASE_URL_FALLBACKS=
# 本地 Embedded Replica（默认开）：读本地文件，写仍进 Turso。远程每查询约 0.5–2s，开后读≈亚毫秒。
# 首次/空文件 sync 可能要 1–3 分钟；之后增量约数秒。关闭：TURSO_EMBEDDED_REPLICA=0
# TURSO_EMBEDDED_REPLICA=1
# TURSO_EMBEDDED_REPLICA_PATH=./data/turso_embedded.db
# TURSO_SYNC_INTERVAL_SEC=30

# 数据源文件路径（可选；默认自动找 文档/额度数据来源.txt）
# FUNDS_SOURCE_FILE=文档/额度数据来源.txt

# 时区（云端服务器默认 UTC，务必设为北京时间）
TIMEZONE=Asia/Shanghai

# 是否启用内置定时任务（Belmo/Fly 生产环境务必 true，保持 7×24 扫描；本地开发可 false）
ENABLE_SCHEDULER=true
# 合作快讯轮询间隔（分钟）
DEAL_POLL_INTERVAL_MIN=2

# 抓取接口密钥（仅外部 cron 调用 /api/cron/scrape 时需要）
SCRAPE_SECRET=请改成随机字符串

# ── AI 合作快讯监控 (deal_monitor) ──
DEAL_T0_MIN_CAP=500000000000
DEAL_T1_MIN_CAP=5000000000
DEAL_T2_MAX_CAP=5000000000
DEAL_SCORE_MIN_DEFAULT=55
DEAL_SCORE_MIN_T0_T0=70
DEAL_DEDUP_DAYS=7
DEAL_MAX_PUSH_PER_HOUR=10
DEAL_T0_T0_PUSH_ENABLED=true
DEAL_T2_T2_PUSH_BOTH=false
DEAL_PUSH_ENABLED=true
DEAL_ADMIN_TOKEN=
SEC_USER_AGENT=YourName your@email.com
FINNHUB_API_KEY=
# Gemini：合作快讯 LLM 筛选（必配其一；多 key 可抗 429）
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2,key3
DEAL_USE_LLM=true
# 可用模型以账号配额为准，如 gemini-2.5-flash
DEAL_LLM_MODEL=gemini-2.5-flash
# 发稿超过 N 天：不入库（防历史 RSS 假 lag）；0=关闭
DEAL_INGEST_MAX_AGE_DAYS=3
# 发稿超过 N 天：已入库也不推送
DEAL_PUSH_MAX_AGE_DAYS=3

# 合作快讯：额外屏蔽的低信源（逗号分隔，小写域名或 Google News 来源名）
# DEAL_BLOCKED_NEWS_SOURCES=mshale,biztoc

# ── 黄仁勋 / NVDA A 档产业动作监控（默认开启，一般无需改）──
NVDA_SIGNAL_ENABLED=true
NVDA_SIGNAL_PUSH_ENABLED=true
NVDA_SIGNAL_A_PLUS_B_ENABLED=true
# NVDA_SIGNAL_PRIOR_A_LOOKBACK_DAYS=90
# NVDA_SIGNAL_A_DEDUP_DAYS=7
# NVDA_SIGNAL_A_PLUS_B_DEDUP_DAYS=14
# NVDA_SIGNAL_PUSH_MIN_CONFIDENCE_A=80
# NVDA_SIGNAL_PUSH_MIN_CONFIDENCE_A_PLUS_B=72

# ── 小公司财报日历（T-2 合并推送 + 结果回看）──
EARNINGS_MONITOR_ENABLED=true
EARNINGS_PUSH_ENABLED=true
EARNINGS_PUSH_DAYS_BEFORE=2
EARNINGS_PUSH_ALLOW_T_MINUS_1=true
EARNINGS_PUSH_ALLOW_T_DAY=false
EARNINGS_PUSH_MIN_SCORE=75
EARNINGS_LOOKAHEAD_DAYS=90
EARNINGS_SCORE_LOOKAHEAD_DAYS=14
EARNINGS_CALENDAR_REFRESH_HOURS=6
EARNINGS_STRATEGY=POST_ER_BUY_WITHIN_2D
EARNINGS_HOLD_TRADING_DAYS_MAX=2
EARNINGS_CHASE_GAP_PCT_BLOCK=15
# 财报后回测窗口（交易日涨跌回填，默认即可）
# EARNINGS_OUTCOME_LOOKBACK_DAYS=14
# EARNINGS_OUTCOME_FALSE_POS_PCT=5
# EARNINGS_OUTCOME_FALSE_NEG_PCT=8

# AI 主线（子板块相对强弱；推送默认关）
AI_MAINLINE_ENABLED=true
AI_MAINLINE_CONFIRM_DAYS=3
AI_MAINLINE_MIN_REL_5D=1.0
AI_MAINLINE_MIN_BREADTH=0.55
AI_MAINLINE_MIN_VALID=3
AI_MAINLINE_PUSH_ENABLED=false
AI_MAINLINE_PUSH_COOLDOWN_DAYS=5

# ── 美股热力图 ──
# TickDB 主数据源（https://tickdb.ai 注册获取，美股格式 AAPL.US）
TICKDB_API_KEY=
# 本地 Yahoo 易 429 时可跳过，直接走 AKShare 新浪日线/东财
# HEATMAP_SKIP_YAHOO=1
# 启用慢速 AKShare 新浪全表（900+ 页，约 8 分钟，一般不需要）
# HEATMAP_SINA_FULL=1

# ── 数据自检 / 缺失补全（部署打断 cron 后自动回填财报涨跌、首日回测等）──
SELF_HEAL_ENABLED=true
SELF_HEAL_INTERVAL_MIN=20
# SELF_HEAL_STARTUP_DELAY_SEC=45
