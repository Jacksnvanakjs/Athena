# PushPlus 配置 (https://www.pushplus.plus/)
PUSHPLUS_TOKEN=your_pushplus_token_here

# Server酱 配置 (https://sct.ftqq.com/) - 可选，与 PushPlus 二选一或同时配置
SERVERCHAN_SENDKEY=your_serverchan_sendkey_here

# 数据库路径
DATABASE_URL=sqlite:///./data/funds.db

# 数据源文件路径
FUNDS_SOURCE_FILE=额度数据来源.txt

# 时区（云端服务器默认 UTC，务必设为北京时间）
TIMEZONE=Asia/Shanghai

# 是否启用内置定时任务（Render 等会休眠的平台设为 false，改用外部 cron）
ENABLE_SCHEDULER=true

# 抓取接口密钥（部署到公网后务必设置，防止他人滥用）
SCRAPE_SECRET=请改成随机字符串
